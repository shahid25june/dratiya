# Internal static file server; TLS is terminated by the server's main Caddy
:80 {
	root * /srv
	encode zstd gzip

	try_files {path} {path}.html
	file_server {
		hide .git Caddyfile Caddyfile.server-snippet docker-compose.yml
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@assets path /css/* /js/*
	header @assets Cache-Control "public, max-age=86400"

	handle_errors {
		@notfound expression {err.status_code} == 404
		redir @notfound / 302
	}
}
